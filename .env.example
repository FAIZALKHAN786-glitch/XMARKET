# =============================================================================
# XMARKET — environment
# Copy to .env.local and fill in what you have. Everything is optional:
# with no keys the app still runs, and every AI endpoint falls back to a
# deterministic heuristic engine that is labelled as such in the UI.
# =============================================================================

# ------------------------------------------------------------------- database
# Set DATABASE_URL to store everything in Postgres. Leave it unset and the app
# falls back to a single JSON file at data/xmarket.json, so a fresh clone still
# runs with nothing to install.
#
#   DATABASE_URL=postgres://user:password@host:5432/xmarket
#
# No local server? `npm run db:dev` starts a throwaway Postgres in .pgdata/ and
# prints the exact DATABASE_URL to use. Tables, indexes and the bids ->
# requirements foreign key are created on first connect; no migration step.
#
# GET /api/health reports which backend is live under database.driver.
# DATABASE_URL=postgres://xmarket:xmarket@127.0.0.1:55432/xmarket

# What a brand-new store contains. The default is empty — a marketplace should
# show records that were actually posted or imported, not invented ones.
#
#   (unset)     empty. No buyers, providers, requirements or offers.
#   parties     the people who can trade — buyers and providers — but no
#               requirements and no offers. Best for demonstrating a buyer
#               workflow from a clean slate, because nothing is invented about
#               procurement activity yet there is somebody to bid.
#   demo        the full sample dataset, invented requirements and offers included.
# XMARKET_SEED=parties

# ---------------------------------------------------------------- LLM provider
# Recommended free option: Google Gemini.
#   1. Sign in at https://aistudio.google.com/apikey with any Google account.
#   2. "Create API key" — no card, no billing account.
#   3. Put it below, uncomment the line, then RESTART `npm run dev`
#      (env files are read once, at boot).
#   4. Confirm with `npm run ai:check` — the probe line must say ok.
#
# Other free tiers: Groq (very fast), OpenRouter (:free models), or Ollama if
# you would rather run a model locally and never send data anywhere.

# Leave AI_PROVIDER unset to auto-detect from whichever key is present, in this
# order: openai -> anthropic -> gemini -> groq -> openrouter -> ollama.
# Set it to force one: openai | anthropic | gemini | groq | openrouter | ollama
# AI_PROVIDER=openai

# --- OpenAI, or any OpenAI-compatible gateway -------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic --------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Google Gemini (recommended, free tier) ---------------------------------
# Google retires Gemini models for new accounts regularly, and a retired model
# returns HTTP 404 ("no longer available to new users") — the app reports this
# as a bad_request with Google's own message, which names the replacement.
# If that happens, set the model below to a current one.
# Current models: https://ai.google.dev/gemini-api/docs/models
#
# GEMINI_API_KEY=AIza...  (or AQ.... — both work, the app never inspects the prefix)
# GEMINI_MODEL=gemini-3.8-flash
#
# Gemini 3.x reasons before answering and those tokens come out of the response
# budget, so the client asks for minimal thinking by default. Raise it only if
# you want deeper deliberation: low | medium | high
# GEMINI_THINKING_LEVEL=low

# --- Groq (fast, cheap, OpenAI-compatible) ----------------------------------
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter -------------------------------------------------------------
# One key, hundreds of models. Several are free — their slugs end in ":free".
# Pick one at https://openrouter.ai/models?max_price=0 and copy its exact slug.
#
# IMPORTANT: if you set only the key, the default model below is a PAID one and
# will 402 without credits. Always set OPENROUTER_MODEL to a ":free" slug.
#
# IMPORTANT: set AI_PROVIDER too. Auto-detection tries openai, anthropic,
# gemini and groq BEFORE openrouter, so any other key you have wins otherwise.
#
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
#
# Free slugs seen in the wild (availability changes — check the models page):
#   deepseek/deepseek-chat-v3.1:free
#   meta-llama/llama-3.3-70b-instruct:free
#   qwen/qwen3-235b-a22b:free
#   google/gemma-3-27b-it:free
#
# OpenRouter's free tier is rate limited. A 429 is reported by the app as a
# quota limit (not a bad key) and is deliberately not retried, so a free
# allowance is not burned by retries.

# --- Ollama, or any local OpenAI-compatible server ---------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=

# ------------------------------------------------------------------- behaviour
# How long a single model call may take before it is abandoned and the
# heuristic fallback answers instead.
# LLM_TIMEOUT_MS=30000

# Public URL, used as the referer when calling OpenRouter.
# APP_URL=http://localhost:3000

# Allow POST /api/admin/reset to wipe data back to the seeded demo set, or to
# drop cached model replies (?scope=ai-cache|data|all). Refused in production
# unless this is exactly "true".
# XMARKET_ALLOW_RESET=false

# Where the JSON store lives. Defaults to ./data/xmarket.json.
# XMARKET_DB_FILE=/absolute/path/to/xmarket.json

# Boot with an empty store instead of the demo dataset. Use this when every
# record in the app should be something you posted or imported. See the
# XMARKET_SEED note near the top for `parties` and `demo`.
# XMARKET_SEED=empty

# Allow POST /api/admin/import to write records in production. Refused unless
# this is exactly "true". Not needed for local development.
# XMARKET_ALLOW_IMPORT=false
