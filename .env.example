# XMARKET — environment
# Copy to .env.local and fill in what you have.

# Session signing key — REQUIRED for production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
XMARKET_SESSION_SECRET=

# Seed data on first boot: (unset)|demo|parties
# XMARKET_SEED=demo

# Path to the JSON store
# XMARKET_DB_FILE=./data/xmarket.json
