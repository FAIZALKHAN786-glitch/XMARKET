# =============================================================================
# XMARKET — environment
# Copy to .env.local and fill in what you have. Everything is optional:
# with no keys the app still runs, and every AI endpoint falls back to a
# deterministic heuristic engine that is labelled as such in the UI.
# =============================================================================

# ---------------------------------------------------------------- LLM provider
# Leave AI_PROVIDER unset to auto-detect from whichever key is present, in this
# order: openai -> anthropic -> gemini -> groq -> openrouter -> ollama.
# Set it to force one: openai | anthropic | gemini | groq | openrouter | ollama
# AI_PROVIDER=openai

# --- OpenAI, or any OpenAI-compatible gateway -------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic --------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Google Gemini ----------------------------------------------------------
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# --- Groq (fast, cheap, OpenAI-compatible) ----------------------------------
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter -------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Ollama, or any local OpenAI-compatible server ---------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=

# ------------------------------------------------------------------- behaviour
# How long a single model call may take before it is abandoned and the
# heuristic fallback answers instead.
# LLM_TIMEOUT_MS=30000

# Public URL, used as the referer when calling OpenRouter.
# APP_URL=http://localhost:3000

# Allow POST /api/admin/reset to wipe data back to the seeded demo set, or to
# drop cached model replies (?scope=ai-cache|data|all). Refused in production
# unless this is exactly "true".
# XMARKET_ALLOW_RESET=false

# Where the JSON store lives. Defaults to ./data/xmarket.json.
# XMARKET_DB_FILE=/absolute/path/to/xmarket.json
