# =============================================================================
# XMARKET — environment
# Copy to .env.local and fill in what you have. Everything is optional:
# with no keys the app still runs, and every AI endpoint falls back to a
# deterministic heuristic engine that is labelled as such in the UI.
# =============================================================================

# ------------------------------------------------------------------- database
# Set DATABASE_URL to store everything in Postgres. Leave it unset and the app
# falls back to a single JSON file at data/xmarket.json, so a fresh clone still
# runs with nothing to install.
#
#   DATABASE_URL=postgres://user:password@host:5432/xmarket
#
# No local server? `npm run db:dev` starts a throwaway Postgres in .pgdata/ and
# prints the exact DATABASE_URL to use. Tables, indexes and the bids ->
# requirements foreign key are created on first connect; no migration step.
#
# GET /api/health reports which backend is live under database.driver.
# DATABASE_URL=postgres://xmarket:xmarket@127.0.0.1:55432/xmarket

# Signs anything that needs a server-side secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Without it the app still runs, but you lose the ability to distinguish one
# deployment from another.
# XMARKET_SESSION_SECRET=

# ---------------------------------------------------------------------- email
# Verification and password-reset links are only delivered if all four of these
# are set. Without them the two request endpoints return the token in the API
# response as `devToken` so the flow can still be exercised — set these and the
# token stops leaving the server.
# XMARKET_SMTP_HOST=smtp.postmarkapp.com
# XMARKET_SMTP_PORT=587
# XMARKET_SMTP_USER=
# XMARKET_SMTP_PASS=
# XMARKET_MAIL_FROM="XMarket <no-reply@yourdomain>"
# Absolute origin used to build the links inside those emails.
# XMARKET_APP_URL=https://your-domain.com

# What a brand-new store contains. The default is empty — a marketplace should
# show records that were actually posted or imported, not invented ones.
#
#   (unset)     empty. No buyers, providers, requirements or offers.
#   parties     the people who can trade — buyers and providers — but no
#               requirements and no offers. Best for demonstrating a buyer
#               workflow from a clean slate, because nothing is invented about
#               procurement activity yet there is somebody to bid.
#   demo        the full sample dataset, invented requirements and offers included.
# XMARKET_SEED=parties

# ---------------------------------------------------------------- LLM provider
# Recommended free option: Google Gemini.
#   1. Sign in at https://aistudio.google.com/apikey with any Google account.
#   2. "Create API key" — no card, no billing account.
#   3. Put it below, uncomment the line, then RESTART `npm run dev`
#      (env files are read once, at boot).
#   4. Confirm with `npm run ai:check` — the probe line must say ok.
#
# Other free tiers: Groq (very fast), OpenRouter (:free models), or Ollama if
# you would rather run a model locally and never send data anywhere.

# Gemini is preferred for XMARKET's AI features whenever its key is configured.
# The FastAPI assistant always uses Gemini; Next.js auto-detection also checks
# Gemini first. Set AI_PROVIDER explicitly only to force a provider (especially
# if you have multiple keys configured).
# If unset, order is: gemini -> openai -> anthropic -> groq -> openrouter -> ollama.
# Supported values: openai | anthropic | gemini | groq | openrouter | ollama
# AI_PROVIDER=gemini

# --- OpenAI, or any OpenAI-compatible gateway -------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic --------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Google Gemini (recommended, free tier) ---------------------------------
# Google retires Gemini models for new accounts regularly, and a retired model
# returns HTTP 404 ("no longer available to new users") — the app reports this
# as a bad_request with Google's own message, which names the replacement.
# If that happens, set the model below to a current one.
# Current models: https://ai.google.dev/gemini-api/docs/models
#
# Keys may start with AIza or AQ; paste the complete key value with no suffix.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
#
# Gemini 3.x reasons before answering and those tokens count toward the output
# budget. The client defaults to the supported low level; raise it only if you
# want deeper deliberation. Supported levels: low | medium | high
# GEMINI_THINKING_LEVEL=low

# --- Groq (fast, cheap, OpenAI-compatible) ----------------------------------
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter -------------------------------------------------------------
# One key, hundreds of models. Several are free — their slugs end in ":free".
# Pick one at https://openrouter.ai/models?max_price=0 and copy its exact slug.
#
# IMPORTANT: if you set only the key, the default model below is a PAID one and
# will 402 without credits. Always set OPENROUTER_MODEL to a ":free" slug.
#
# IMPORTANT: set AI_PROVIDER too if you have multiple provider keys. When
# AI_PROVIDER is unset, Gemini is checked before OpenRouter.
#
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
#
# Free slugs seen in the wild (availability changes — check the models page):
#   deepseek/deepseek-chat-v3.1:free
#   meta-llama/llama-3.3-70b-instruct:free
#   qwen/qwen3-235b-a22b:free
#   google/gemma-3-27b-it:free
#
# OpenRouter's free tier is rate limited. A 429 is reported by the app as a
# quota limit (not a bad key) and is deliberately not retried, so a free
# allowance is not burned by retries.

# --- Ollama, or any local OpenAI-compatible server ---------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=

# ------------------------------------------------- FastAPI service (AI + OAuth2)
# AI calls and OAuth2 (password -> JWT, Google sign-in) run on a separate
# FastAPI process (backend/). The browser only ever talks to the Next.js
# origin; next.config.mjs proxies /fastapi/* to it. The FastAPI service reads
# this same .env.local, so GEMINI_API_KEY above configures its model too.
#
#   npm run py:install   create backend/.venv and install backend/requirements.txt
#   npm run py:dev       run the service on http://127.0.0.1:8000
#
# Without it running, the AI routes transparently fall back to the built-in
# Next.js implementation, so the app never breaks.

# Where Next.js proxies /fastapi/* to. Change only if the service runs
# somewhere other than this machine.
# FASTAPI_URL=http://127.0.0.1:8000

# Where the FastAPI service reaches the Next.js app (for the deterministic
# data reads its AI answers pull context from, and the audit-event writer).
# NEXT_BASE_URL=http://127.0.0.1:3000

# Key the FastAPI service signs its xmarket_jwt bearer tokens with. The app
# verifies that cookie with the same key (so one login works across both
# halves). Falls back to XMARKET_SESSION_SECRET, then a local-dev default.
# XMARKET_OAUTH2_SECRET=

# Shared secret for the sibling-service route POST /api/internal/record-event
# (the FastAPI service records AI activity through it). Falls back to
# XMARKET_SESSION_SECRET, then the same local-dev default.
# XMARKET_INTERNAL_SECRET=

# Public origin of the FastAPI service, used to build the Google OAuth
# redirect URI. In the default same-origin /fastapi/* deployment leave this
# unset and the redirect is derived from the incoming request.
# PUBLIC_BASE_URL=https://your-domain.com/fastapi

# --- Google sign-in (optional) ----------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials,
# type "OAuth client ID" -> "Web application", and add the redirect URI the
# service reports (GET /fastapi/health -> google.redirectUri) to the authorized
# redirect URIs. That URI is derived from the host you browse from, so it
# changes between localhost, a preview domain and production.
#
# Without both values the "Continue with Google" button says Google sign-in is
# not configured. The same endpoint reports `google.reachable` — the consent
# screen runs in the browser, but the code exchange is server-to-server, so a
# machine with no egress to oauth2.googleapis.com cannot finish a sign-in even
# with valid credentials.
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# ------------------------------------------------------------------- behaviour
# How long a single model call may take before it is abandoned and the
# heuristic fallback answers instead.
# LLM_TIMEOUT_MS=30000

# Public URL, used as the referer when calling OpenRouter.
# APP_URL=http://localhost:3000

# Allow POST /api/admin/reset to wipe data back to the seeded demo set, or to
# drop cached model replies (?scope=ai-cache|data|all). Refused in production
# unless this is exactly "true".
# XMARKET_ALLOW_RESET=false

# Where the JSON store lives. Defaults to ./data/xmarket.json.
# XMARKET_DB_FILE=/absolute/path/to/xmarket.json

# Boot with an empty store instead of the demo dataset. Use this when every
# record in the app should be something you posted or imported. See the
# XMARKET_SEED note near the top for `parties` and `demo`.
# XMARKET_SEED=empty

# Allow POST /api/admin/import to write records in production. Refused unless
# this is exactly "true". Not needed for local development.
# XMARKET_ALLOW_IMPORT=false
