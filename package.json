{
  "name": "xmarket",
  "version": "0.1.0",
  "private": true,
  "description": "XMARKET — a needs-first reverse marketplace where buyers post requirements and providers bid, ranked by an intelligent compatibility engine.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "rebuild": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "ai:check": "node scripts/ai-check.mjs",
    "api:smoke": "bash scripts/api-smoke.sh",
    "data:import": "node scripts/import-tenders.mjs",
    "tags:check": "node --experimental-strip-types scripts/tag-check.mjs",
    "db:dev": "node scripts/dev-postgres.mjs",
    "py:install": "python3 -m venv backend/.venv && backend/.venv/bin/pip install -q --upgrade pip && backend/.venv/bin/pip install -q -r backend/requirements.txt",
    "py:dev": "backend/.venv/bin/uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.454.0",
    "next": "^15.1.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
